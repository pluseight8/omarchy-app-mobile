widget "Canvas sampler" {
  meta { owl: 1; description: "A live canvas with OWL expressions, shapes, and Omarchy colors." }
  size: 2x1
  padding: 14
  background: surface

  Column {
    gap: 6
    Text { text: "OWL canvas"; style: title; color: foreground }
    Canvas {
      width: 300
      height: 64
      let phase = (time % 4) / 4
      let x = 8 + phase * (width - 16)
      line(4, height / 2, width - 4, height / 2, stroke: muted, width: 1)
      rect(8, height - 14, width - 16, 8, fill: alpha(accent, 0.18), radius: 4)
      rect(8, height - 14, max(0, x - 8), 8, fill: accent, radius: 4)
      circle(x, height / 2, 5, fill: foreground)
      text("OFFLINE", 14, 20, color: muted, size: 10)
    }
  }
}
